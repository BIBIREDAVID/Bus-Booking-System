PORT=4000
WEB_ORIGIN=http://localhost:5173

# Run `npx prisma dev` (from /api) in its own terminal and leave it running —
# it prints a DATABASE_URL like the one below (port varies per run). Paste
# the "TCP" connection string it prints into your local .env.
#
# Keep `&pgbouncer=true` on the end: `prisma dev`'s local Postgres
# (PGlite) doesn't handle Prisma's named prepared statements correctly
# across requests — without this flag you'll intermittently see
# `prepared statement "s0" already exists` errors once the API has been
# running a while. This flag makes Prisma use unnamed statements
# instead (same workaround used for PgBouncer). Harmless against real
# Postgres too, so leave it on if you later point this at a hosted DB
# that also sits behind a connection pooler.
DATABASE_URL="postgresql://postgres:postgres@localhost:51213/template1?sslmode=disable&pgbouncer=true"

JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

OTP_EXPIRES_IN_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_REQUEST_WINDOW_MINUTES=10

# Trip generation (see src/jobs/generateTrips.ts)
TRIP_GENERATION_WINDOW_DAYS=30
# Set to false if trips are generated by an external scheduler instead
# (e.g. `npm run generate-trips` invoked by a Railway/host cron job)
ENABLE_CRON=true
TRIP_GENERATION_CRON="0 2 * * *"
# How often expired seat_holds rows get purged (see src/jobs/purgeExpiredHolds.ts)
PURGE_HOLDS_CRON="*/5 * * * *"
# How often reserved_unpaid bookings past their pay-at-park cutoff get
# cancelled (see src/jobs/cancelUnpaidBookings.ts)
CANCEL_UNPAID_CRON="*/5 * * * *"

# Payment gateways — real keys go here once available. Never commit
# real secrets; webhook signature verification depends on these being
# correct (see lib/paymentGateways.ts).
SQUAD_SECRET_KEY=
PAYSTACK_SECRET_KEY=
